{
  "name": "point-thinning",
  "version": "0.0.0",
  "description": "A distance-based geographical 2D point thinning algorithm",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p .",
    "bench": "node --strip-types bench.ts",
    "posttest": "tsc --noEmit test.ts --allowImportingTsExtensions --ignoreConfig",
    "test": "node --strip-types --test"
  },
  "author": "Renée Kooi <renee@kooi.me>",
  "keywords": [
    "geography",
    "sampling",
    "distribution",
    "pruning"
  ],
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "dependencies": {
    "@turf/helpers": "^7.3.4",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.0.2"
  },
  "devDependencies": {
    "@turf/random": "^7.3.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.5.2",
    "@types/papaparse": "^5.5.2",
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.3",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.6"
  }
}
